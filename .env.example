# ATLAS configuration. Copy this file to .env and fill in your values.
# .env is git-ignored: never commit it. Real environment variables override values here.

# --- Secrets (leave empty here; set them in .env) -------------------------------------------

# Required in connected mode: Anthropic API key (console.anthropic.com -> Settings -> API Keys).
ANTHROPIC_API_KEY=

# Required for live data fetches (GitHub GraphQL needs authentication). A fine-grained token with
# read-only access to public repositories is enough.
GITHUB_TOKEN=

# Token used only to publish draft pull requests to ATLAS_PUBLISH_TARGET. Scope it to that one
# repository (contents and pull requests: read and write). Nothing else uses it.
ATLAS_PUBLISH_TOKEN=

# --- Publication ------------------------------------------------------------------------------

# The only repository ATLAS may publish draft pull requests to, as owner/repository. Never an
# upstream project and never a watched repository. Leave the placeholder to keep publication off.
ATLAS_PUBLISH_TARGET=<owner>/<repo>

# --- Mode and spending --------------------------------------------------------------------------

# connected: model calls go to the Anthropic API over an allow-listed endpoint.
# offline: every outbound connection is refused and counted; model steps fail closed.
ATLAS_MODE=connected

# Hard ceiling in USD for model spend; runs stop when it is reached.
ATLAS_SPEND_CEILING_USD=40

# --- Models -------------------------------------------------------------------------------------

# anthropic: Claude over the internet (connected mode).
# openai_compatible: a model server inside your network (for example vLLM), for offline mode.
ATLAS_MODEL_PROVIDER=anthropic
ATLAS_MODEL_REASONING=claude-sonnet-5-5
ATLAS_MODEL_FAST=claude-haiku-5-5
# Only for openai_compatible: the server address, its host names allowed in offline mode
# (comma-separated), and its key if it needs one.
ATLAS_MODEL_BASE_URL=
ATLAS_MODEL_INTERNAL_HOSTS=
ATLAS_MODEL_API_KEY=

# --- Server -------------------------------------------------------------------------------------

# Must stay a loopback address while the demo role header is the identity.
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000

# Identity: 'header' (role header X-Atlas-Role, for tests and development, loopback only),
# 'local' (built-in sign-in) or 'oidc' (company single sign-on, not available in this build).
ATLAS_IDENTITY=header

# Organisation name used in host names, for example atlas.<slug>.internal.
ATLAS_ORG_SLUG=demo

# Extra browser origin allowed during UI development (loopback only), e.g. the dev server.
ATLAS_UI_ORIGIN=http://127.0.0.1:5173

# normal: the demo server. scenario: a separate server with its own data directory that also
# accepts demonstration faults, clock and spend changes (ATLAS_DEMO_SCENARIOS=true).
ATLAS_SERVER_ROLE=normal
ATLAS_DEMO_SCENARIOS=false

# URL of the other demo server's UI, used by the guided demo to hand off between servers.
ATLAS_PEER_UI_URL=http://127.0.0.1:8001

# Project shown first when nobody has chosen one yet (an id from your projects file).
ATLAS_DEFAULT_PROJECT=

# A public repository link the Add project screen starts with (for example
# https://github.com/owner/name). The audit role still reviews and confirms it.
ATLAS_ADD_PROJECT=

# Addresses the demo script uses. Leave empty to build them from ATLAS_HOST and ATLAS_PORT
# (the scenario server is then expected on the next port).
ATLAS_BASE_URL=
ATLAS_SCENARIO_URL=

# --- Demo script values ---------------------------------------------------------------------------

# Ids the guided demo fills into its steps. They come from your own snapshots; leave empty to skip
# the steps that need them.
ATLAS_DEMO_RELEASE_SNAPSHOT=
ATLAS_DEMO_ALIASED_SNAPSHOT=
ATLAS_DEMO_RELEASE_ID=
ATLAS_DEMO_RELEASE_FILTER=
ATLAS_DEMO_CASE_G01=
ATLAS_DEMO_CASE_G03=
ATLAS_DEMO_CASE_G04=

# Where stores and snapshots live (relative to the project folder, or an absolute path).
ATLAS_DATA_DIR=data
# Where the sandbox container images are cached after the one-time download.
ATLAS_IMAGE_CACHE=data/local/images

# --- Sandbox and tools ----------------------------------------------------------------------------

# local_docker: run checks in a locked-down container on this machine.
# remote: hand them to a separate runner (not available in this build).
# none: never run repository code (tasks can be prepared but not approved for publication).
ATLAS_SANDBOX_RUNNER=local_docker
# Leave empty to find each tool on PATH; set a full path only if it is installed elsewhere.
ATLAS_DOCKER_BIN=
ATLAS_GO_BIN=
ATLAS_OPENSSL_BIN=

# --- Automatic runs -----------------------------------------------------------------------------

# Repository the watchers follow, as owner/repository. Leave the placeholder to keep watchers off.
ATLAS_WATCH_REPOSITORY=<owner>/<repo>
# Extra upstream repositories ATLAS reads from and must never publish to (comma-separated).
# The watched repository and every repository in the projects file are always included.
ATLAS_UPSTREAM_REPOSITORIES=
# Start a release-close run when a new release tag appears.
ATLAS_WATCH_RELEASES=false
# Start investigations for new failure events (flaky-test issues, failed CI jobs).
ATLAS_WATCH_FAILURES=false
ATLAS_FAILURE_POLL_MINUTES=15
# Daily time (24h, local) for the nightly sweep.
ATLAS_NIGHTLY_TIME=02:00
# Scheduled question digests (off by default).
ATLAS_QUESTION_DIGEST=false

# --- External notifications (optional) ------------------------------------------------------------

# Webhook for Slack, Mattermost or an email relay. Leave empty to keep notifications in-app only.
ATLAS_WEBHOOK_URL=
# Who reads that channel: a role (pm, em, architect, security, oncall, audit) or 'public'.
# Content is filtered for this audience. With no audience declared, nothing is sent.
ATLAS_WEBHOOK_AUDIENCE=
