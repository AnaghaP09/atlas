# ATLAS configuration. Copy this file to .env and fill in your values.
# .env is git-ignored: never commit it. Real environment variables override values here.

# --- Secrets (leave empty here; set them in .env) -------------------------------------------

# Required in connected mode: Anthropic API key (console.anthropic.com -> Settings -> API Keys).
ANTHROPIC_API_KEY=

# Required for live data fetches (GitHub GraphQL needs authentication). A fine-grained token with
# read-only access to public repositories is enough.
GITHUB_TOKEN=

# Token used only to publish draft pull requests to ATLAS_PUBLISH_TARGET. Scope it to that one
# repository (contents and pull requests: read and write). Nothing else uses it.
ATLAS_PUBLISH_TOKEN=

# --- Publication ------------------------------------------------------------------------------

# The only repository ATLAS may publish draft pull requests to. Never an upstream project.
ATLAS_PUBLISH_TARGET=AnaghaP09/atlas-sandbox-target

# --- Mode and spending --------------------------------------------------------------------------

# connected: model calls go to the Anthropic API over an allow-listed endpoint.
# offline: every outbound connection is refused and counted; model steps fail closed.
ATLAS_MODE=connected

# Hard ceiling in USD for model spend; runs stop when it is reached.
ATLAS_SPEND_CEILING_USD=40

# Models
ATLAS_MODEL_REASONING=claude-sonnet-5-5
ATLAS_MODEL_FAST=claude-haiku-5-5

# --- Server -------------------------------------------------------------------------------------

# Must stay a loopback address while the demo role header is the identity.
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000

# Identity: 'header' (demo role header X-Atlas-Role). Sign-in is not part of this build.
ATLAS_IDENTITY=header

# Extra browser origin allowed during UI development (loopback only), e.g. the dev server.
ATLAS_UI_ORIGIN=http://127.0.0.1:5173

# normal: the demo server. scenario: a separate server with its own data directory that also
# accepts demonstration faults, clock and spend changes (ATLAS_DEMO_SCENARIOS=true).
ATLAS_SERVER_ROLE=normal
ATLAS_DEMO_SCENARIOS=false

# URL of the other demo server's UI, used by the guided demo to hand off between servers.
ATLAS_PEER_UI_URL=http://127.0.0.1:8001

# Where stores and snapshots live.
ATLAS_DATA_DIR=data

# --- Automatic runs -----------------------------------------------------------------------------

# Repository the watchers follow.
ATLAS_WATCH_REPOSITORY=kubevirt/kubevirt
# Start a release-close run when a new release tag appears.
ATLAS_WATCH_RELEASES=false
# Start investigations for new failure events (flaky-test issues, failed CI jobs).
ATLAS_WATCH_FAILURES=false
ATLAS_FAILURE_POLL_MINUTES=15
# Daily time (24h, local) for the nightly sweep.
ATLAS_NIGHTLY_TIME=02:00
# Scheduled question digests (off by default).
ATLAS_QUESTION_DIGEST=false

# --- External notifications (optional) ------------------------------------------------------------

# Webhook for Slack, Mattermost or an email relay. Leave empty to keep notifications in-app only.
ATLAS_WEBHOOK_URL=
# Who reads that channel: a role (pm, em, architect, security, oncall, audit) or 'public'.
# Content is filtered for this audience. With no audience declared, nothing is sent.
ATLAS_WEBHOOK_AUDIENCE=
