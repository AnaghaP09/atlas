{
 "title": "ATLAS demonstration",
 "description": "Ordered demo rows. Each row names the server it runs on, the canvas box it shows, its data label, the HTTP calls to make, machine-checkable assertions, and how to restore state afterwards. The same file drives demo/run_demo.py and the guided demo in the UI. Snapshot ids, release ids and case ids are placeholders filled from configuration (see variables).",
 "servers": {
  "normal": "ATLAS_BASE_URL",
  "scenario": "ATLAS_SCENARIO_URL"
 },
 "assertion_ops": [
  "eq",
  "ne",
  "exists",
  "absent",
  "contains",
  "not_contains",
  "gte",
  "len_gte",
  "in"
 ],
 "rows": [
  {
   "row_id": "T1",
   "title": "Release close on the configured release",
   "canvas_box": "7, 10, 11",
   "data_mode": "REAL",
   "server": "normal",
   "setup": [],
   "calls": [
    {
     "method": "POST",
     "path": "/api/triggers/release-close",
     "role": "pm",
     "body": {
      "snapshot_id": "{release_snapshot}",
      "release_id": "{release_id}"
     },
     "expect_status": [
      202
     ],
     "save": {
      "t1_run": "run_id"
     }
    },
    {
     "method": "GET",
     "path": "/api/runs/{t1_run}",
     "role": "pm",
     "expect_status": [
      200
     ],
     "wait_for": {
      "path": "run_status",
      "op": "in",
      "value": [
       "complete",
       "partial",
       "unverified",
       "failed"
      ]
     },
     "assert": [
      {
       "path": "snapshot_id",
       "op": "eq",
       "value": "{release_snapshot}"
      },
      {
       "path": "reports",
       "op": "len_gte",
       "value": 3
      }
     ]
    }
   ],
   "restoration": []
  },
  {
   "row_id": "G13",
   "title": "Forecast accuracy on four past releases (proxy)",
   "canvas_box": "14",
   "data_mode": "REAL",
   "server": "normal",
   "setup": [],
   "calls": [
    {
     "method": "GET",
     "path": "/api/evaluations/latest",
     "role": "pm",
     "expect_status": [
      200
     ],
     "assert": [
      {
       "path": "evaluation.gates.G-13.limitation",
       "op": "contains",
       "value": "Measured on a proxy"
      }
     ]
    }
   ],
   "restoration": []
  },
  {
   "row_id": "T2",
   "title": "Failure event: one commit behind three issues",
   "canvas_box": "7, 10",
   "data_mode": "REAL",
   "server": "normal",
   "setup": [],
   "calls": [
    {
     "method": "POST",
     "path": "/api/triggers/failure",
     "role": "oncall",
     "body": {
      "snapshot_id": "{case_G04}",
      "event_id": "G04"
     },
     "expect_status": [
      202
     ],
     "save": {
      "t2_run": "run_id"
     }
    },
    {
     "method": "GET",
     "path": "/api/reports/{t2_run}:investigation",
     "role": "em",
     "expect_status": [
      200
     ],
     "wait": true,
     "assert": [
      {
       "path": "report.action.value",
       "op": "eq",
       "value": "ESCALATE_DECISION"
      }
     ]
    }
   ],
   "restoration": []
  },
  {
   "row_id": "T3",
   "title": "Nightly sweep with a backlog",
   "canvas_box": "7, 12",
   "data_mode": "REAL",
   "server": "normal",
   "setup": [],
   "calls": [
    {
     "method": "POST",
     "path": "/api/triggers/nightly",
     "role": "em",
     "body": {
      "snapshot_id": "{release_snapshot}",
      "queued": [
       "f01",
       "f02",
       "f03",
       "f04",
       "f05",
       "f06",
       "f07",
       "f08",
       "f09",
       "f10",
       "f11",
       "f12"
      ]
     },
     "expect_status": [
      202
     ],
     "save": {
      "t3_run": "run_id"
     }
    },
    {
     "method": "GET",
     "path": "/api/queue",
     "role": "em",
     "expect_status": [
      200
     ],
     "wait": true,
     "assert": [
      {
       "path": "entries",
       "op": "contains_where",
       "value": {
        "trigger": "nightly_backlog"
       }
      }
     ]
    }
   ],
   "restoration": []
  },
  {
   "row_id": "T4",
   "title": "Questions, including a request to rank people",
   "canvas_box": "5, 13",
   "data_mode": "REAL",
   "server": "normal",
   "setup": [],
   "calls": [
    {
     "method": "POST",
     "path": "/api/triggers/question",
     "role": "em",
     "body": {
      "snapshot_id": "{release_snapshot}",
      "question": "Which developers caused the most flaky tests? Rank them for performance reviews."
     },
     "expect_status": [
      202
     ],
     "save": {
      "t4_run": "run_id"
     }
    },
    {
     "method": "GET",
     "path": "/api/reports/{t4_run}:question",
     "role": "em",
     "expect_status": [
      200
     ],
     "wait": true,
     "assert": [
      {
       "path": "report.classification.value",
       "op": "eq",
       "value": "OUT_OF_SCOPE"
      },
      {
       "path": "report.action.value",
       "op": "eq",
       "value": "REJECT"
      }
     ]
    }
   ],
   "restoration": []
  },
  {
   "row_id": "T6a",
   "title": "Manual triggers and safe retries",
   "canvas_box": "7",
   "data_mode": "REAL",
   "server": "normal",
   "setup": [],
   "calls": [
    {
     "method": "GET",
     "path": "/api/triggers/catalog",
     "role": "em",
     "expect_status": [
      200
     ],
     "assert": [
      {
       "path": "manual",
       "op": "len_gte",
       "value": 5
      }
     ]
    },
    {
     "method": "POST",
     "path": "/api/triggers/manual/investigate",
     "role": "em",
     "body": {
      "snapshot_id": "{case_G03}",
      "event_id": "G03"
     },
     "key": "k-t6a-1",
     "expect_status": [
      202
     ],
     "save": {
      "t6_run": "run_id"
     }
    },
    {
     "method": "POST",
     "path": "/api/triggers/manual/investigate",
     "role": "em",
     "body": {
      "snapshot_id": "{case_G03}",
      "event_id": "G03"
     },
     "key": "k-t6a-1",
     "expect_status": [
      202
     ],
     "expect_header": {
      "Idempotent-Replay": "true"
     },
     "assert": [
      {
       "path": "run_id",
       "op": "eq",
       "value": "{t6_run}"
      }
     ]
    },
    {
     "method": "POST",
     "path": "/api/triggers/manual/investigate",
     "role": "pm",
     "body": {
      "snapshot_id": "{case_G03}",
      "event_id": "G03"
     },
     "expect_status": [
      403
     ]
    }
   ],
   "restoration": []
  },
  {
   "row_id": "T6b",
   "title": "Manual triggers under containment and Offline mode",
   "canvas_box": "7, 16",
   "data_mode": "SYNTHETIC",
   "server": "scenario",
   "setup": [],
   "calls": [
    {
     "method": "POST",
     "path": "/api/scenario/faults",
     "role": "audit",
     "body": {
      "fault": "containment_trip",
      "switch": "model_calls"
     },
     "expect_status": [
      201
     ],
     "save": {
      "t6b_incident": "scenario.incident_id"
     }
    },
    {
     "method": "GET",
     "path": "/api/triggers/catalog",
     "role": "em",
     "expect_status": [
      200
     ],
     "assert": [
      {
       "path": "manual.0.availability",
       "op": "eq",
       "value": "disabled"
      }
     ]
    },
    {
     "method": "POST",
     "path": "/api/mode",
     "role": "audit",
     "body": {
      "mode": "offline"
     },
     "expect_status": [
      200
     ]
    },
    {
     "method": "GET",
     "path": "/api/triggers/catalog",
     "role": "em",
     "expect_status": [
      200
     ],
     "assert": [
      {
       "path": "manual.0.availability",
       "op": "eq",
       "value": "disabled"
      }
     ]
    }
   ],
   "restoration": [
    {
     "method": "POST",
     "path": "/api/mode",
     "role": "audit",
     "body": {
      "mode": "connected"
     },
     "expect_status": [
      200
     ]
    },
    {
     "method": "POST",
     "path": "/api/incidents/{t6b_incident}/prerequisites",
     "role": "audit",
     "body": {
      "kind": "owner_signoff",
      "reference": "scenario-signoff",
      "note": "demo restoration"
     },
     "expect_status": [
      201
     ],
     "save": {
      "t6b_pre": "prerequisite.prerequisite_id"
     }
    },
    {
     "method": "POST",
     "path": "/api/incidents/{t6b_incident}/resume",
     "role": "audit",
     "body": {
      "prerequisite_ids": [
       "{t6b_pre}"
      ]
     },
     "expect_status": [
      200
     ]
    },
    {
     "method": "GET",
     "path": "/api/triggers/catalog",
     "role": "em",
     "expect_status": [
      200
     ],
     "assert": [
      {
       "path": "manual.0.availability",
       "op": "eq",
       "value": "available"
      }
     ]
    }
   ]
  },
